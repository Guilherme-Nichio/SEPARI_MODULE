# ───────────────────────────────────────────────────────────────
# Separi — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com os seus valores.
#   cp .env.example .env
# ───────────────────────────────────────────────────────────────

# Supabase (obrigatório) — painel do projeto › Settings › API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# WhatsApp comercial (somente dígitos, com DDI + DDD).
# Opcional — se vazio, usa o número padrão 5519974059048.
VITE_WHATSAPP_NUMBER=5519974059048

# NOTA (v81): o número do WhatsApp deixou de depender desta variável.
# Ele agora vive em src/site/siteConfig.ts (WHATSAPP_DIGITS), para que um .env
# desatualizado não consiga mandar os cliques para a linha errada.
# A variável fica aqui só por compatibilidade com scripts antigos.
